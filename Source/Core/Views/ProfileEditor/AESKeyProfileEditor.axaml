<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:profileEditor="clr-namespace:Core.ViewModels.ProfileEditor"
    xmlns:paks="clr-namespace:Core.Models.Profiles.Paks"

    x:Class="Core.Views.ProfileEditor.AESKeyProfileEditor"
    x:DataType="profileEditor:ProfileEditorViewModel"

    mc:Ignorable="d"
    d:DesignWidth="700"
    d:DesignHeight="550"

    Focusable="True">

    <UserControl.Resources>
        <!-- One row per key. Compact enough that a 30 container archive is a scroll, not an expedition. -->
        <DataTemplate x:Key="KeyRowTemplate" DataType="paks:PakKeyEntry">
            <Border Background="{DynamicResource ExpanderHeaderBackground}"
                    BorderBrush="{DynamicResource ExpanderHeaderBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14 10">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <!-- Green once the key parses, hollow while the container is still locked -->
                    <Border Grid.Column="0"
                            Width="8" Height="8"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="#3FB950"
                            IsVisible="{Binding HasKey}"/>

                    <Border Grid.Column="0"
                            Width="8" Height="8"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            BorderThickness="1.5"
                            BorderBrush="#8B949E"
                            IsVisible="{Binding !HasKey}"/>

                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplayName}"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Guid}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Opacity="0.45"
                                       IsVisible="{Binding HasContainer}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBox Text="{Binding Key, Mode=TwoWay}"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 Watermark="0x…"
                                 Classes="clearButton"
                                 Padding="8 4"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Margin="0 0 14 0">

        <!-- Summary + search -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="15" Margin="0 5 25 15">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <fluent:FluentIcon Icon="KeyMultiple" FontSize="17" VerticalAlignment="Center"/>

                <TextBlock Text="{Binding KeySummary}"
                           FontSize="14"
                           Opacity="0.75"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBox Grid.Column="1"
                     Text="{Binding KeySearch, Mode=TwoWay}"
                     Watermark="Filter by container or guid"
                     Classes="clearButton"
                     FontSize="13"
                     Width="240"
                     Height="30"
                     Padding="8 4"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Orientation="Vertical" Margin="0 0 25 0">

                <TextBlock Text="Nothing matches that filter"
                           FontSize="14"
                           Opacity="0.5"
                           Margin="2 20 0 0"
                           IsVisible="{Binding HasNoSearchResults}"/>

                <!-- Containers this installation has and cannot open -->
                <StackPanel Orientation="Vertical" Spacing="10" IsVisible="{Binding HasLockedResults}">
                    <TextBlock Text="{Binding LockedHeader}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Opacity="0.55"
                               Margin="2 0 0 0"/>

                    <ItemsControl ItemsSource="{Binding LockedContainers}"
                                  ItemTemplate="{StaticResource KeyRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Leftovers from builds this profile used to point at -->
                <StackPanel Orientation="Vertical" Spacing="10" Margin="0 20 0 0" IsVisible="{Binding HasOrphanedResults}">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="2 0 0 0">
                        <TextBlock Text="{Binding OrphanedHeader}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.55"
                                   VerticalAlignment="Center"/>

                        <fluent:FluentIcon Icon="Info"
                                           FontSize="14"
                                           Opacity="0.55"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="Keys kept from earlier builds. Nothing here is loaded, and none of it is doing any harm."/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding OrphanedKeys}"
                                  ItemTemplate="{StaticResource KeyRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
